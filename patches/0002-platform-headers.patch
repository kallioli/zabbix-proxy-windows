Headers: Windows definitions for the types and primitives the proxy needs

POSIX types, thread and service declarations that the Unix build gets
from the system headers.

diff --git a/include/common/zbxsysinc.h b/include/common/zbxsysinc.h
index 0bc54862899ff2c4974338917b789e8d605573a1..ec04d18ed840041da483cbc3427c5331f8a4c027 100644
--- a/include/common/zbxsysinc.h
+++ b/include/common/zbxsysinc.h
@@ -57,6 +57,16 @@
 /* to speed build process and reduce size of the Win32 header files */
 #	define WIN32_LEAN_AND_MEAN	1
 #	include <windows.h>
+
+/* configure records the width of size_t on Unix and nothing does here; zbxcommon.h sizes the large receive */
+/* limit by it (16 GiB when it is wider than 4), which the proxy needs for the configuration the server sends */
+#	ifndef SIZEOF_SIZE_T
+#		ifdef _WIN64
+#			define SIZEOF_SIZE_T	8
+#		else
+#			define SIZEOF_SIZE_T	4
+#		endif
+#	endif
 #endif
 
 #ifdef HAVE_PROCESS_H
@@ -431,4 +441,51 @@
 #	include <setjmp.h>
 #endif
 
+#ifdef _WINDOWS
+/* rpcndr.h, reached through winsock2.h and Iphlpapi.h, defines 'interface' as a macro. Zabbix uses that word as an */
+/* identifier in about a thousand places - zbx_dc_interface_t interface; and the like - which the substitution turns */
+/* into syntax errors. Nothing here uses the COM meaning of the keyword. */
+#	undef interface
+
+/* access() mode constants, which MSVC declares the function for but does not name. Windows has no execute permission */
+/* to test, so X_OK checks for read, which is what _access() accepts. */
+#	ifndef F_OK
+#		define F_OK	0
+#		define W_OK	2
+#		define R_OK	4
+#		define X_OK	R_OK
+#	endif
+
+/* guard shared with the MSVC <sys/types.h>, which declares _mode_t but only exposes mode_t under the non-standard */
+/* names option */
+#	ifndef _MODE_T_DEFINED
+#		define _MODE_T_DEFINED
+typedef int	mode_t;
+#	endif
+
+/* runtime control identifies a target by process id; the guard is the one the MSVC headers use, so whichever */
+/* declaration comes first wins */
+#	ifndef _PID_T_
+#		define _PID_T_
+typedef int	pid_t;
+#	endif
+
+/* the worker pools of the discoverer, the asynchronous pollers and the preprocessing manager synchronise with POSIX */
+/* threads directly */
+#	include "zbxwinpthread.h"
+
+/* MSVC spells the reentrant tokeniser differently, with the same signature */
+#	define strtok_r	strtok_s
+
+/* implemented in src/libs/zbxwin/posix_win.c */
+struct timeval;
+#	define CLOCK_REALTIME	0
+#	define CLOCK_MONOTONIC	1
+int		clock_gettime(int clk_id, struct timespec *tp);
+int		nanosleep(const struct timespec *req, struct timespec *rem);
+unsigned int	sleep(unsigned int seconds);
+int		gettimeofday(struct timeval *tv, void *tz);
+char		*strptime(const char *s, const char *format, struct tm *tm);
+#endif
+
 #endif
diff --git a/include/common/zbxtypes.h b/include/common/zbxtypes.h
index f8020fb621c710d00b3493f55e13ac2c70eba4bf..9eff1130b5692785dbfec963f75b93bdf9e52bf9 100644
--- a/include/common/zbxtypes.h
+++ b/include/common/zbxtypes.h
@@ -26,12 +26,24 @@
 #if defined(_WINDOWS)
 #	include <strsafe.h>
 
+/* These have to widen the constant, not just pass it through. Without the suffix the literal stays an int, and a */
+/* shift such as the one that builds SHMEM_FLG_USED - (__UINT64_C(1)) << 63 - shifts past the width of its type and */
+/* yields zero. The shared memory allocator then cannot tell a used chunk from a free one. The definitions below */
+/* match the ones used everywhere else. */
 #	ifndef __UINT64_C
-#		define __UINT64_C(x)	x
+#		ifdef UINT64_C
+#			define __UINT64_C(c)	(UINT64_C(c))
+#		else
+#			define __UINT64_C(c)	(c ## ULL)
+#		endif
 #	endif
 
 #	ifndef __INT64_C
-#		define __INT64_C(x)	x
+#		ifdef INT64_C
+#			define __INT64_C(c)	(INT64_C(c))
+#		else
+#			define __INT64_C(c)	(c ## LL)
+#		endif
 #	endif
 
 #	define zbx_uint64_t	unsigned __int64
@@ -191,6 +203,9 @@ zbx_uint128_t;
 
 #if defined(_WINDOWS) || defined(__MINGW32__)
 	#define localtime_r(x, y)	localtime_s(y, x)
+	/* MSVC has no gmtime_r; gmtime_s takes (dest, src) like localtime_s and the */
+	/* callers ignore the return value, so the same mapping holds. */
+	#define gmtime_r(x, y)		gmtime_s(y, x)
 #endif
 
 typedef struct zbx_variant zbx_variant_t;
@@ -209,10 +224,7 @@ typedef struct zbx_variant zbx_variant_t;
 #define	SEND_ERROR	-10
 #define	RECV_ERROR	-11
 
-#if !defined(_WINDOWS)
-/* database connection pool */
+/* database connection pool; the Windows build produces the proxy, which uses it, so no Unix guard here */
 typedef struct zbx_dbconn_pool zbx_dbconn_pool_t;
 
 #endif
-
-#endif
